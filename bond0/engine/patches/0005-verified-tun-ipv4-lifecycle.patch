+
+    #[test]
+    fn route_parse_detects_tunnel_local_ip() {
+        let out = "\r\nActive Routes:\r\nNetwork Destination        Netmask          Gateway   Interface  Metric\r\n      198.18.0.0  255.255.255.0    On-link    198.18.0.2     271\r\n";
