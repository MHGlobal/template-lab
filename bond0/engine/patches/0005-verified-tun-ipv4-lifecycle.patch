+#[cfg(test)]
+mod bond0_lifecycle_tests {
+    use super::*;
+
+    const EN_SAMPLE: &str = "\r\nConfiguration for interface \"Bond0\"\r\n   DHCP enabled:  No\r\n   IP Address:       198.18.0.2\r\n   Subnet Prefix:     255.255.255.0 (/24)\r\n   InterfaceMetric:  5000\r\n";
+    const PT_SAMPLE: &str = "\r\nConfiguracao da interface \"Bond0\"\r\n   DHCP ativado:  Nao\r\n   Endereco IP:  198.18.0.2\r\n   Prefixo de Sub-rede:  255.255.255.0 (/24)\r\n";
+    const APIPA_SAMPLE: &str =
+        "\r\n   IP Address:  169.254.140.109\r\n   Subnet Prefix: 255.255.0.0 (/16)\r\n";
+
+    #[test]
+    fn assign_args_only_target_named_adapter() {
+        let args = build_assign_address_args(
+            "Bond0",
+            "198.18.0.2".parse().unwrap(),
+            "255.255.255.0".parse().unwrap(),
+        );
+        assert_eq!(
+            args,
+            vec![
+                "interface",
+                "ipv4",
+                "set",
+                "address",
+                "name=Bond0",
+                "static",
+                "198.18.0.2",
+                "255.255.255.0",
+            ]
+            .into_iter()
+            .map(String::from)
+            .collect::<Vec<_>>()
+        );
+        // No gateway argument can ever be produced by this path.
+        assert!(!args.iter().any(|a| a.eq_ignore_ascii_case("gateway")));
+        assert_eq!(args.iter().filter(|a| a.starts_with("name=")).count(), 1);
+    }
+
+    #[test]
+    fn show_addresses_args_are_read_only() {
+        let args = build_show_addresses_args("Bond0");
+        assert_eq!(
+            args,
+            vec!["interface", "ipv4", "show", "addresses", "name=Bond0",]
+                .into_iter()
+                .map(String::from)
+                .collect::<Vec<_>>()
+        );
+        assert!(!args.iter().any(|a| a.eq_ignore_ascii_case("set")));
+    }
+
+    #[test]
+    fn verify_parse_matches_english_and_portuguese_netsh() {
+        let ip: Ipv4Addr = "198.18.0.2".parse().unwrap();
+        let mask: Ipv4Addr = "255.255.255.0".parse().unwrap();
+        assert!(parse_assigned_ipv4_present(EN_SAMPLE, ip, 24, mask));
+        assert!(parse_assigned_ipv4_present(PT_SAMPLE, ip, 24, mask));
+        assert!(!parse_assigned_ipv4_present(APIPA_SAMPLE, ip, 24, mask));
+        assert!(!parse_assigned_ipv4_present("", ip, 24, mask));
+    }
+
+    #[test]
+    fn verify_parse_requires_matching_prefix() {
+        let ip: Ipv4Addr = "198.18.0.2".parse().unwrap();
+        let mask16: Ipv4Addr = "255.255.0.0".parse().unwrap();
+        let out = "Endereco IP: 198.18.0.2 Mascara: 255.255.0.0 (/16)";
+        assert!(!parse_assigned_ipv4_present(
+            out,
+            ip,
+            24,
+            "255.255.255.0".parse().unwrap()
+        ));
+        assert!(parse_assigned_ipv4_present(out, ip, 16, mask16));
+    }
+
+    #[test]
+    fn route_print_args_are_read_only() {
+        let args = build_route_print_args("198.18.0.1".parse().unwrap());
