+/// Pure: netsh arguments that assign one static IPv4 to one named adapter.
+/// Only ever references the virtual adapter; no gateway argument is
+/// produced, so default routes and physical interfaces are untouched.
+fn build_assign_address_args(interface_name: &str, ipv4: Ipv4Addr, mask: Ipv4Addr) -> Vec<String> {
+    vec![
+        "interface".to_string(),
+        "ipv4".to_string(),
+        "set".to_string(),
+        "address".to_string(),
+        format!("name={interface_name}"),
+        "static".to_string(),
+        ipv4.to_string(),
+        mask.to_string(),
+    ]
+}
+
+/// Pure: netsh arguments to READ the IPv4 configuration of one adapter.
+fn build_show_addresses_args(interface_name: &str) -> Vec<String> {
+    vec![
+        "interface".to_string(),
+        "ipv4".to_string(),
+        "show".to_string(),
+        "addresses".to_string(),
+        format!("name={interface_name}"),
+    ]
+}
+
+/// Pure: locale-tolerant confirmation that `netsh interface ipv4 show
+/// addresses` output contains the expected address with a matching prefix
+/// or dotted mask. Only value literals are matched, never localized labels.
+fn parse_assigned_ipv4_present(output: &str, ipv4: Ipv4Addr, prefix: u8, mask: Ipv4Addr) -> bool {
+    if !output.contains(ipv4.to_string().as_str()) {
+        return false;
+    }
+    output.contains(&format!("/{prefix}")) || output.contains(mask.to_string().as_str())
+}
+
+/// Pure: route.exe arguments to READ the active route for a destination.
+/// Read-only: the only verb is `print`; never ADD/CHANGE/DELETE.
+fn build_route_print_args(dest: Ipv4Addr) -> Vec<String> {
+    vec!["print".to_string(), "-4".to_string(), dest.to_string()]
+}
+
+/// Pure: locale-tolerant check that `route print` output mentions the
+/// tunnel local IP as the route interface (the connected on-link route).
+fn parse_route_via_local_ip(output: &str, local_ip: Ipv4Addr) -> bool {
+    output.contains(local_ip.to_string().as_str())
+}
+
+fn run_netsh_owned(args: &[String]) -> Result<String> {
+    run("netsh", args)
+}
