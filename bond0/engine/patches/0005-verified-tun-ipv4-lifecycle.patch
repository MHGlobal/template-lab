+/// Read-only verification that the named adapter currently holds the given
+/// IPv4/prefix. Never mutates adapter, route or firewall state.
+pub fn verify_windows_tun_ipv4(interface_name: &str, ipv4: Ipv4Addr, prefix: u8) -> Result<bool> {
+    let mask = prefix_to_mask(prefix)?;
+    let out = run_netsh_owned(&build_show_addresses_args(interface_name))?;
+    Ok(parse_assigned_ipv4_present(&out, ipv4, prefix, mask))
+}
+
+/// Read-only check that the OS has an active route for `dest` whose
+/// interface is the tunnel local IP (the connected on-link route).
+pub fn check_windows_route_via_local_ip(dest: Ipv4Addr, local_ip: Ipv4Addr) -> Result<bool> {
+    let args = build_route_print_args(dest);
+    let out = run("route", &args)?;
+    Ok(parse_route_via_local_ip(&out, local_ip))
+}
