+/// Set only the IPv4 address and prefix on a specifically selected virtual
+/// adapter. No route, gateway, DNS, firewall, MTU or WAN changes.
+pub fn assign_windows_tun_ipv4_only(
+    interface_name: &str,
+    ipv4: Ipv4Addr,
+    prefix: u8,
+) -> Result<()> {
+    let mask = prefix_to_mask(prefix)?;
+    if ipv4.is_unspecified() || ipv4.is_multicast() || ipv4.is_loopback() || prefix == 0 {
+        bail!("invalid tunnel ASSIGN address/prefix: {ipv4}/{prefix}");
+    }
+    netsh(&[
+        "interface",
+        "ipv4",
+        "set",
+        "address",
+        &format!("name={interface_name}"),
+        "static",
+        &ipv4.to_string(),
+        &mask.to_string(),
+    ])
+    .with_context(|| format!("could not assign {ipv4}/{prefix} on virtual adapter '{interface_name}'"))?;
+    Ok(())
+}
