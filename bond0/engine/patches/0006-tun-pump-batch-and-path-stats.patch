+/// Per-path counters shared between the select loop (sends) and the
+/// per-path receive tasks. Updated with brief Mutex locks only; the lock
+/// is never held across an await point.
+#[cfg(target_os = "windows")]
+#[derive(Default, Clone, Copy)]
+struct PathStatCounters {
+    sent_pkts: u64,
+    sent_bytes: u64,
+    recv_pkts: u64,
+    recv_bytes: u64,
+}
+
+/// Record one uplink datagram on the given path (id-indexed).
+#[cfg(target_os = "windows")]
+fn record_path_sent(stats: &Arc<Mutex<Vec<PathStatCounters>>>, path_id: usize, bytes: u64) {
+    if let Ok(mut s) = stats.lock() {
+        if let Some(c) = s.get_mut(path_id) {
+            c.sent_pkts = c.sent_pkts.saturating_add(1);
+            c.sent_bytes = c.sent_bytes.saturating_add(bytes);
+        }
+    }
+}
+
+/// Record one downlink datagram on the given path (id-indexed).
+#[cfg(target_os = "windows")]
+fn record_path_recv(stats: &Arc<Mutex<Vec<PathStatCounters>>>, path_id: usize, bytes: u64) {
+    if let Ok(mut s) = stats.lock() {
+        if let Some(c) = s.get_mut(path_id) {
+            c.recv_pkts = c.recv_pkts.saturating_add(1);
+            c.recv_bytes = c.recv_bytes.saturating_add(bytes);
+        }
+    }
+}
