+/// Collect completed background tasks without blocking the keyboard loop.
+/// Most importantly, a failed task no longer consumes the next Start press.
+fn settle_finished_runner(
+    handle: &Handle,
+    runner: &SharedRunner,
+    state: &Arc<Mutex<UiState>>,
+) -> Result<()> {
+    let finished_task = {
+        let mut guard = runner
+            .lock()
+            .map_err(|_| anyhow!("UI runner lock poisoned"))?;
+        if guard.1.as_ref().is_some_and(|task| task.is_finished()) {
+            let finished = guard.1.take();
+            // A fresh watch receiver is retained by this UI controller on restart.
+            guard.0.send_replace(false);
+            finished
+        } else {
+            None
+        }
+    };
+    if let Some(task) = finished_task {
+        let outcome = handle.block_on(task);
+        let mut s = state
+            .lock()
+            .map_err(|_| anyhow!("UI state lock poisoned"))?;
+        s.running = false;
+        s.starting = false;
+        s.stopping = false;
+        s.start_time = None;
+        if let Err(e) = outcome {
+            s.failed = true;
+            s.push_log(format!("Engine task failed: {e}"));
+        } else if !s.failed {
+            s.push_log("Engine stopped");
+        }
+    }
     Ok(())
 }
 
+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    #[test]
+    fn default_ui_state_does_not_claim_connected() {
+        let s = UiState {
+            config_path: PathBuf::from("client.toml"),
+            config: BondingConfig::default(),
+            running: false,
+            starting: false,
+            stopping: false,
+            failed: false,
+            logs: VecDeque::new(),
+            log_scroll: 0,
+            start_time: None,
+        };
+        assert!(!s.running);
+        assert!(!s.starting);
+        assert!(!s.stopping);
+        assert!(!s.failed);
+    }
+}
