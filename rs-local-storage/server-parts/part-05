getAbsolutePath());frame=mmr.getFrameAtTime(2000000,MediaMetadataRetriever.OPTION_CLOSEST_SYNC);if(frame==null)frame=mmr.getFrameAtTime();if(frame!=null){int w=480,h=Math.max(270,(int)(frame.getHeight()*(480.0/frame.getWidth())));scaled=Bitmap.createScaledBitmap(frame,w,h,true);FileOutputStream fos=new FileOutputStream(jpg);try{scaled.compress(Bitmap.CompressFormat.JPEG,76,fos);}finally{fos.close();}}}catch(Exception ignored){}finally{try{mmr.release();}catch(Exception ignored){}if(scaled!=null&&scaled!=frame)scaled.recycle();if(frame!=null)frame.recycle();}
        }
        if(!jpg.exists()){sendSvgPlaceholder(out,cleanTitle(video.getName()));return;}byte[] data=readFile(jpg);sendBytes(out,200,"OK","image/jpeg",data,"private, max-age=86400");
    }

    void sendSvgPlaceholder(OutputStream out,String title)throws Exception{String svg="<svg xmlns='http://www.w3.org/2000/svg' width='480' height='270'><rect width='100%' height='100%' fill='#111827'/><circle cx='240' cy='118' r='34' fill='#ffffff22'/><path d='M232 99l28 19-28 19z' fill='white'/><text x='240' y='205' fill='#cbd5e1' font-family='sans-serif' font-size='18' text-anchor='middle'>"+xml(title)+"</text></svg>";sendBytes(out,200,"OK","image/svg+xml",svg.getBytes(StandardCharsets.UTF_8),"private, max-age=3600");}

    List<File> mediaFiles(File root,int depth,int limit){ArrayList<File> out=new ArrayList<>();collectVideos(root,depth,limit,out);Collections.sort(out,Comparator.comparing(File::getName,String.CASE_INSENSITIVE_ORDER));return out;}
    void collectVideos(File d,int depth,int limit,List<File> out){if(d==null||depth<0||out.size()>=limit)return;File[] fs=d.listFiles();if(fs==null)return;for(File f:fs){if(out.size()>=limit)return;if(f.isDirectory())collectVideos(f,depth-1,limit,out);else if(isVideo(f))out.add(f);}}
    File firstVideo(File d,int depth){if(d==null||depth<0)return null;File[] fs=d.listFiles();if(fs==null)return null;Arrays.sort(fs,Comparator.comparing(File::getName,String.CASE_INSENSITIVE_ORDER));for(File f:fs)if(f.isFile()&&isVideo(f))return f;for(File f:fs)if(f.isDirectory()){File x=firstVideo(f,depth-1);if(x!=null)return x;}return null;}
    boolean isVideo(File f){String n=f.getName().toLowerCase(Locale.US);return n.endsWith(".mp4")||n.endsWith(".m4v")||n.endsWith(".webm")||n.endsWith(".mkv")||n.endsWith(".mov")||n.endsWith(".avi");}
    String mime(File f){String n=f.getName().toLowerCase(Locale.US);if(n.endsWith(".webm"))return "video/webm";if(n.endsWith(".mkv"))return "video/x-matroska";if(n.endsWith(".mov"))return "video/quicktime";if(n.endsWith(".avi"))return "video/x-msvideo";return "video/mp4";}
    String cleanTitle(String name){int dot=name.lastIndexOf('.');if(dot>0)name=name.substring(0,dot);return name.replace('_',' ').replace('.', ' ').trim();}

