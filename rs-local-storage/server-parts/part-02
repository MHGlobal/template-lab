 null;}}s.expires=System.currentTimeMillis()+SESSION_MS;return s;}
    void cleanupSessions(){long n=System.currentTimeMillis();for(Map.Entry<String,Session> e:sessions.entrySet())if(e.getValue().expires<n)sessions.remove(e.getKey());}
    String cookie(Map<String,String> h){String c=h.get("cookie");if(c==null)return null;for(String x:c.split(";")){x=x.trim();if(x.startsWith("RSSESSION="))return x.substring(10);}return null;}
    void updateActiveClients(){cleanupSessions();HashSet<Integer> active=new HashSet<>();for(Session s:sessions.values())if(s.client())active.add(s.clientSlot);getSharedPreferences("rs",MODE_PRIVATE).edit().putInt("active_clients",active.size()).apply();}

    File safeAdmin(String rel)throws IOException{if(rel==null)rel="";File r=storageRoot().getCanonicalFile(),f=new File(r,rel).getCanonicalFile();guardInside(r,f);return f;}
    File safeMedia(String rel)throws IOException{if(rel==null)rel="";File r=mediaRoot().getCanonicalFile(),f=new File(r,rel).getCanonicalFile();guardInside(r,f);return f;}
    void guardInside(File root,File f)throws IOException{String rp=root.getCanonicalPath(),fp=f.getCanonicalPath();if(!fp.equals(rp)&&!fp.startsWith(rp+File.separator))throw new SecurityException("Caminho bloqueado");}

    void adminFiles(OutputStream out,File d,Session session)throws Exception{
        if(!d.exists()||!d.isDirectory()){sendHtml(out,404,"Not Found",errorPage("Pasta não encontrada","O diretório já não existe.","/"));return;}
        String current=storageRoot().toURI().relativize(d.toURI()).getPath();StringBuilder rows=new StringBuilder();
        if(!d.getCanonicalFile().equals(storageRoot().getCanonicalFile())){File p=d.getParentFile();rows.append(fileRow("↩","Voltar","Pasta anterior","/admin/files?d="+url(storageRoot().toURI().relativize(p.toURI()).getPath()),false));}
        File[] fs=d.listFiles();if(fs!=null){Arrays.sort(fs,new Comparator<File>(){public int compare(File a,File b){if(a.isDirectory()!=b.isDirectory())return a.isDirectory()?-1:1;return a.getName().compareToIgnoreCase(b.getName());}});for(File f:fs){String rel=storageRoot().toURI().relativize(f.toURI()).getPath();if(f.isDirectory())rows.append(fileRow("▰",esc(f.getName()),"Pasta","/admin/files?d="+url(rel),false));else rows.append(fileRow("·",esc(f.getName()),size(f.length()),"/admin/download?f="+url(rel),true));}}
        String body=adminShell("Ficheiros","Acesso total ao armazenamento", "<section class='panel upload'><div><strong>Enviar ficheiros</strong><p>Destino: /"+esc(current)+"</p></div><input id='up' type='file' multiple><button onclick='upload()'>Enviar</button><span id='msg'></span></section><section class='panel list'>"+rows+"</section><script>async function upload(){const fs=document.getElementById('up').files,m=document.getElementById('msg');if(!fs.length){m.textContent='Escolha ficheiros.';return;}for(const f of fs){m.textContent='A enviar '+f.name+'…';const r=await fetch('/admin/upload?d="+url(current)+"&name='+encodeURIComponent(f.name),{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:f});if(!r.ok){m.textContent='Falha em '+f.name;return;}}m.textContent='Concluído';setTimeout(()=>location.reload(),500)}</script>",session);
        sendHtml(out,200,"OK",body);
    }

