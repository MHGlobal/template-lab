            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#62B1FF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="A iniciar RS Screen Manager..." Foreground="#BECDDF" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2" Text="connect+ · v0.4.0 preview" Foreground="#97ABC4" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>
        <!-- Dedicated advanced settings drawer; controls are preserved but no longer clutter daily workflows. -->
        <Grid x:Name="AdvancedLayer" Grid.RowSpan="4" Background="#C9090B10" Visibility="Collapsed">
            <Border x:Name="AdvancedDrawer" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="500" BorderBrush="#344E6C" BorderThickness="1,0,0,0" Background="#111B2A" Padding="26,28">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="AdvancedPanelTitle" Text="Opções avançadas" FontSize="26" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AdvancedPanelSubtitle" Text="Controlo detalhado, sem complicar o ecrã principal." Foreground="#AFC1D8" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="CloseAdvanced_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Fechar opções avançadas" ToolTipService.ToolTip="Fechar painel avançado"><FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons"/></Button>
                        </Grid>
                        <StackPanel x:Name="GamingAdvancedSection" Visibility="Collapsed" Spacing="12">
                            <Border Background="#241F1D" BorderBrush="#584134" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" Foreground="#FF6B35" FontSize="18"/><TextBlock Text="PERFIL GAMING" Foreground="#FF936E" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                                    <TextBlock Text="Aplica uma predefinição de vídeo para reduzir ajustes repetidos. A taxa real depende do Android e da ligação." Foreground="#D7E3F0" FontSize="12" TextWrapping="Wrap"/>
                                    <Button Content="Aplicar perfil 120 FPS / 24 Mbps (alvo)" Click="GamingPreset_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="O editor de multitoque e os comandos WASD/mira ainda precisam de integração ao protocolo Android. O gestor legado permanece opcional, mas não é a interface principal." Foreground="#C2D1E4" FontSize="12" TextWrapping="Wrap"/>
                            <Button Content="Abrir ferramentas legadas (compatibilidade)" Click="Advanced_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <Border BorderBrush="#334B65" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                            <TextBlock Text="VÍDEO E FLUIDEZ" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <TextBlock Text="FPS de referência" Foreground="#DFE8F7"/>
                        <ComboBox x:Name="FpsCombo" SelectedIndex="0" HorizontalAlignment="Stretch"><x:String>60</x:String><x:String>30</x:String><x:String>90</x:String><x:String>120</x:String></ComboBox>
                        <TextBlock Text="Taxa de vídeo (Mbps)" Foreground="#DFE8F7"/>
                        <ComboBox x:Name="BitrateCombo" SelectedIndex="0" HorizontalAlignment="Stretch"><x:String>16</x:String><x:String>8</x:String><x:String>24</x:String></ComboBox>
                        <TextBlock Text="LAUNCHER PERSONALIZADO" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox x:Name="LauncherBox" Header="Identificador do pacote Android" Text="org.fossify.home" PlaceholderText="ex.: org.fossify.home"/>
                        <TextBlock Text="Usa esta opção apenas se escolheres «Launcher personalizado» ao criar um ecrã virtual." Foreground="#9EADC7" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="ORIENTAÇÃO" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Automático inicia com a orientação atual do Android sem impor landscape; resoluções fixas são uma escolha manual. Nem todas as apps permitem rotação ou ecrã virtual." Foreground="#B8C8DE" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="SEGURANÇA" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="O Companion é opcional. ADB exige permissão do dispositivo; não existe acesso root implícito." Foreground="#B8C8DE" FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Guardar definições avançadas" Click="SaveAdvanced_Click" Style="{StaticResource BlueButton}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid x:Name="WelcomeOverlay" Grid.RowSpan="4" Background="#F0090B10" Visibility="Collapsed" Padding="16">
            <Border x:Name="WelcomeCard" Width="630" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#162437" BorderBrush="#486686" BorderThickness="1" CornerRadius="16" Padding="35">
                <StackPanel Spacing="19">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="#72B6FF"/>
                        <TextBlock Text="RS SCREEN MANAGER · CONNECT+" Foreground="#80BAFF" FontSize="12" CharacterSpacing="90" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="WelcomeStepTitle" Text="Bem-vindo ao RS Screen Manager" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="White"/>
                    <TextBlock x:Name="WelcomeStepText" Text="Vamos apresentar a ligação Android, o ecrã virtual e as funcionalidades disponíveis nesta versão." FontSize="15" Foreground="#C3D1E5" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="WelcomeProgress" Text="Passo 1 de 3" Foreground="#97AAC6" FontSize="12" VerticalAlignment="Center"/>
                        <Button x:Name="WelcomeNextButton" Grid.Column="1" Content="Continuar" Click="WelcomeNext_Click" Style="{StaticResource BlueButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>