<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RSScreenManagerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RS Screen Manager · connect+">
    <Grid x:Name="RootGrid" Background="#090B10" RequestedTheme="Dark" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" RowDefinitions="Auto,Auto,*,Auto">
        <Grid.Resources>
            <AcrylicBrush x:Key="GlassBrush" TintColor="#182337" TintOpacity="0.68" TintLuminosityOpacity="0.50" FallbackColor="#141D29"/>
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
                <Setter Property="BorderBrush" Value="#34495F"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="PerformanceCard" TargetType="Border">
                <Setter Property="Background" Value="#111C29"/>
                <Setter Property="BorderBrush" Value="#2A3D52"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="22"/>
            </Style>
            <Style x:Key="BlueButton" TargetType="Button">
                <Setter Property="Background" Value="#007BFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="18,12"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="#1D2A3B"/>
                <Setter Property="Foreground" Value="#F5F8FD"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#AAB9CC"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="NavActiveButton" TargetType="Button">
                <Setter Property="Background" Value="#1B3452"/>
                <Setter Property="Foreground" Value="#F7FBFF"/>
                <Setter Property="BorderBrush" Value="#3A76C1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#DAE6F4"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <!-- Brand mark: abstract linked-screens glyph, consistent at small sizes. -->
        <Grid Padding="30,19,30,17" ColumnDefinitions="Auto,*,Auto" MinHeight="90">
            <Border Width="48" Height="48" Background="#007BFF" CornerRadius="12" VerticalAlignment="Center" BorderBrush="#5DB4FF" BorderThickness="1">
                <Viewbox Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="40" Height="40">
                        <Path Data="M 8,9 L 26,9 Q 31,9 31,14 L 31,26" Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M 32,31 L 14,31 Q 9,31 9,26 L 9,15" Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M 15,23 L 25,17" Stroke="#C7EDFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Width="6" Height="6" Canvas.Left="8" Canvas.Top="7" Fill="#FFFFFF"/>
                        <Ellipse Width="6" Height="6" Canvas.Left="26" Canvas.Top="27" Fill="#FFFFFF"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0" Spacing="2">
                <TextBlock Text="RS Screen Manager" FontSize="19" FontWeight="SemiBold" Foreground="#F7F9FD"/>
                <TextBlock Text="connect+  ·  WINDOWS CONTROL" FontSize="10" CharacterSpacing="75" Foreground="#87B8F5"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Border x:Name="ConnectivityChip" Background="#13291F" BorderBrush="#2D6548" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="ConnectivityIcon" Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#83D9A4"/>
                        <TextBlock x:Name="OnlineBadge" Text="A verificar dispositivos" Foreground="#C6E9D2" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Click="Refresh_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Atualizar dispositivos" ToolTipService.ToolTip="Atualizar dispositivos">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        <TextBlock Text="Atualizar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Six grouped navigation targets; all eleven functional pages remain available. -->
        <Grid Grid.Row="1" Padding="30,2,30,14" ColumnDefinitions="*,Auto" MinHeight="64">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button x:Name="NavHome" Click="Home_Click" Style="{StaticResource NavActiveButton}" AutomationProperties.Name="Início">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Início"/></StackPanel>
                    </Button>
                    <Button x:Name="NavDevices" Click="Devices_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Dispositivos">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE772;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Dispositivos"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSessions" Style="{StaticResource NavButton}" AutomationProperties.Name="Sessões">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Sessões"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Espelhamento" Click="MirrorPage_Click"/>
                            <MenuFlyoutItem Text="Ecrãs virtuais" Click="VirtualPage_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="NavGaming" Style="{StaticResource NavButton}" AutomationProperties.Name="Gaming">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Gaming"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Centro Gaming" Click="Gaming_Click"/>
                            <MenuFlyoutItem Text="Editor de controlos" Click="Mapper_Click"/>
                            <MenuFlyoutItem Text="Perfis de desempenho" Click="Profiles_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="NavLibrary" Click="History_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Biblioteca">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Biblioteca"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTools" Style="{StaticResource NavButton}" AutomationProperties.Name="Ferramentas e definições">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Ferramentas"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Diagnóstico" Click="Diagnostics_Click"/>
                            <MenuFlyoutItem Text="Definições" Click="Settings_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Ajuda e primeiros passos" Click="Help_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="CurrentLocationText" Grid.Column="1" Text="Visão geral" Foreground="#8D9DB2" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer x:Name="HomePanel">
                <StackPanel MaxWidth="1210" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="O teu Android, sob controlo." Foreground="#F5F8FF" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Começa por ligar o telemóvel. Depois escolhe espelhar o ecrã ou abrir uma aplicação num ecrã virtual." Foreground="#A9B7CA" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" Foreground="#80BAFF" FontSize="16"/>
                                    <TextBlock Text="PASSO 1 · LIGAR / PASSO 2 · ESCOLHER" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="11" CharacterSpacing="65" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="O que queres fazer agora?" Foreground="White" FontWeight="SemiBold" FontSize="24" TextWrapping="Wrap"/>
                                <TextBlock Text="Um ecrã virtual abre uma aplicação sem ocupar o ecrã principal do Android. Espelhamento mostra o que já está no telemóvel." Foreground="#B1BFD1" FontSize="13" TextWrapping="Wrap" MaxWidth="610"/>
                                <StackPanel x:Name="HomeActionsPanel" Orientation="Horizontal" Spacing="10">
                                    <Button Click="Devices_Click" Style="{StaticResource BlueButton}" AutomationProperties.Name="Ligar ou escolher telemóvel"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE772;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="1 · Ligar Android"/></StackPanel></Button>
                                    <Button Click="HotspotPage_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Conectar por hotspot do telemóvel">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="Hotspot do telemóvel"/></StackPanel>
                                    </Button>
                                    <Button Click="VirtualPage_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Criar ecrã virtual">
                                        <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="15"/><TextBlock Text="2 · Ecrã virtual"/></StackPanel>
                                    </Button>
                                    <Button Click="MirrorPage_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Abrir espelhamento">
                                        <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" FontSize="15"/><TextBlock Text="2 · Espelhar"/></StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="HeroVisual" Grid.Column="1" Width="214" Height="168" CornerRadius="12" Background="#0B1524" BorderBrush="#2A4F7A" BorderThickness="1" VerticalAlignment="Center">
                                <Grid Margin="19,15">
                                    <Border Width="130" Height="89" BorderBrush="#37608C" BorderThickness="2" CornerRadius="9" Background="#142A45" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0">
                                        <StackPanel Margin="14" Spacing="11">
                                            <Border Background="#2E5177" Height="5" Width="64" HorizontalAlignment="Left" CornerRadius="2"/>
                                            <Border Background="#2E5177" Height="5" Width="91" HorizontalAlignment="Left" CornerRadius="2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="126" Height="87" BorderBrush="#70B9FF" BorderThickness="2" CornerRadius="9" Background="#063767" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,5">
                                        <StackPanel Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="#E4F3FF"/>
                                            <Border Background="#7DBEFF" Height="4" Width="61" CornerRadius="2"/>
                                            <Border Background="#3D92EF" Height="4" Width="42" CornerRadius="2"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="27" Height="27" CornerRadius="14" Background="#007BFF" BorderBrush="#91C9FF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid x:Name="HomeStatsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                        <Border x:Name="DevicesStatCard" Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE772;" FontSize="18" Foreground="#75BAFF"/><TextBlock Text="Dispositivos disponíveis" Foreground="#D8E9FB" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <TextBlock x:Name="DeviceCountText" Text="A procurar dispositivos..." Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceSummaryText" Text="Liga por USB ou configura depuração sem fios." Foreground="#AAB8CC" TextWrapping="Wrap" FontSize="13"/>
                                <Button Content="Ver dispositivos" Click="Devices_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SessionsStatCard" Grid.Column="1" Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A0;" FontSize="18" Foreground="#75BAFF"/><TextBlock Text="Sessões ativas" Foreground="#D8E9FB" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                <TextBlock x:Name="SessionCountText" Text="0 sessões nesta execução" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="Espelhamento e ecrãs virtuais em janelas independentes." Foreground="#AAB8CC" TextWrapping="Wrap" FontSize="13"/>
                                <Button Content="Gerir sessões" Click="MirrorPage_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="12">
                        <TextBlock Text="Acesso rápido" Style="{StaticResource SectionHeading}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Width="284" Style="{StaticResource GlassCard}">
                                    <StackPanel Spacing="12">
                                        <Border Background="#352920" CornerRadius="9" Width="42" Height="42" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="#FF6B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Gaming" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Controlos e perfis para jogos Android." Foreground="#AEBED1" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="Abrir Gaming" Click="Gaming_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="284" Style="{StaticResource GlassCard}">
                                    <StackPanel Spacing="12">
                                        <Border Background="#19314D" CornerRadius="9" Width="42" Height="42" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#80BAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Perfis de qualidade" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Ajusta resolução, FPS e desempenho." Foreground="#AEBED1" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="Ver perfis" Click="Profiles_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="284" Style="{StaticResource GlassCard}">
                                    <StackPanel Spacing="12">
                                        <Border Background="#19314D" CornerRadius="9" Width="42" Height="42" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#80BAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Diagnóstico" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Verifica conexão, ADB e permissões." Foreground="#AEBED1" FontSize="12" TextWrapping="Wrap"/>
                                        <Button Content="Ver estado" Click="Diagnostics_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DevicesPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Os teus dispositivos" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Deteção USB e Wi-Fi. Apenas dispositivos autorizados podem iniciar sessões." Foreground="#A9B7CA" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="DISPOSITIVOS DETETADOS" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ComboBox x:Name="DevicesCombo" Visibility="Collapsed" PlaceholderText="Sem dispositivo selecionado" HorizontalAlignment="Stretch" SelectionChanged="DeviceSelection_Changed"/>
                            <GridView x:Name="DeviceGrid" MaxHeight="240" SelectionMode="Single" AutomationProperties.Name="Dispositivos detetados" SelectionChanged="GridSelection_Changed" HorizontalAlignment="Stretch">
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="230" Height="122" Background="#243045" CornerRadius="9" BorderThickness="1" BorderBrush="#50617E" Padding="16" Margin="3">
                                            <StackPanel Spacing="7">
                                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8EA;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#78B5FF"/><TextBlock Text="ANDROID" Foreground="#78B5FF" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                                                <TextBlock Text="{Binding}" Foreground="White" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                                <TextBlock Text="Selecionar dispositivo" Foreground="#A9B9D0" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <StackPanel x:Name="DevicesEmptyState" Visibility="Collapsed" Spacing="8" Padding="0,12,0,12">
                                <FontIcon Glyph="&#xE8EA;" FontFamily="Segoe Fluent Icons" Foreground="#73AADB" FontSize="25"/>
                                <TextBlock Text="Nenhum dispositivo detetado" Foreground="#E6F0FA" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Liga um Android por USB, autoriza a depuração no telemóvel e volta a procurar. Também podes emparelhar por Wi-Fi abaixo." Foreground="#B5C8DF" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                            <Button Click="Refresh_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="14"/><TextBlock Text="Procurar dispositivos"/></StackPanel></Button>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ASSISTENTE DE LIGAÇÃO SEM FIOS" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="1. No Android, abre Opções de programador → Depuração sem fios → Emparelhar com código." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBlock Text="2. Introduz o endereço IP:porta do emparelhamento e o PIN de seis dígitos." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBlock Text="3. Depois do emparelhamento, usa o endereço IP:porta de ligação, que pode ser diferente." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBox x:Name="EndpointBox" Header="Endereço IP:porta" PlaceholderText="192.168.1.10:37123"/>
                            <TextBox x:Name="PairCodeBox" Header="Código de emparelhamento" PlaceholderText="6 dígitos"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Emparelhar" Click="Pair_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="Conectar" Click="Connect_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="Desconectar" Click="Disconnect_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#70B5FF"/>
                                <TextBlock Text="HOTSPOT DO TELEMÓVEL" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Liga o computador ao ponto de acesso criado pelo Android. Não é necessário ter Internet: é necessária uma ligação local e autorização ADB." Foreground="#D9E6F5" TextWrapping="Wrap"/>
                            <TextBlock Text="1. Ativa o Hotspot pessoal no Android. 2. No computador, liga-te à rede Wi-Fi criada. 3. Verifica a ligação abaixo." Foreground="#B5C7DD" FontSize="13" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Click="OpenWindowsWifi_Click" Style="{StaticResource QuietButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE701;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="Abrir Wi-Fi do Windows"/></StackPanel>
                                </Button>
                                <Button x:Name="HotspotScanButton" Click="ScanHotspot_Click" Style="{StaticResource QuietButton}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="Verificar ligação"/></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="REDES DE HOTSPOT COM PERFIL JÁ GUARDADO NO WINDOWS" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="11"/>
                            <ComboBox x:Name="HotspotSavedNetworksCombo" Header="Redes Wi-Fi conhecidas nas proximidades" PlaceholderText="Clica em Verificar ligação" HorizontalAlignment="Stretch" AutomationProperties.Name="Rede Wi-Fi gravada para conexão"/>
                            <Button x:Name="JoinSavedHotspotButton" Content="Conectar à rede Wi-Fi selecionada" Click="JoinSavedHotspot_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" IsEnabled="False"/>
                            <TextBlock Text="Só são apresentadas aqui redes próximas já guardadas no Windows. Para a primeira ligação a um novo hotspot, usa as Definições Wi-Fi do Windows para introduzir a palavra-passe com segurança." FontSize="12" Foreground="#A9BCD4" TextWrapping="Wrap"/>
                            <ComboBox x:Name="HotspotInterfaceCombo" Header="Interface Wi-Fi conectada" PlaceholderText="Verificar primeiro a ligação" HorizontalAlignment="Stretch" SelectionChanged="HotspotInterface_Changed" AutomationProperties.Name="Escolher interface conectada ao hotspot"/>
                            <TextBlock x:Name="HotspotNetworkInfo" Text="Ainda não foi verificada nenhuma interface. Um gateway identificado é apenas um endereço candidato — não prova que o Android tem ADB ativo." Foreground="#A9BCD4" TextWrapping="Wrap" FontSize="12"/>
                            <Border Background="#102236" BorderBrush="#315477" BorderThickness="1" CornerRadius="10" Padding="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="AUTORIZAÇÃO ADB · ESCOLHE O MÉTODO" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="11" CharacterSpacing="70"/>
                                    <TextBlock Text="Com cabo USB: seleciona um Android autorizado e ativa ADB TCP/IP no próprio dispositivo. Depois podes retirar o cabo e ligar ao endereço da rede." Foreground="#BDCEE2" TextWrapping="Wrap" FontSize="12"/>
                                    <Button x:Name="HotspotUsbButton" Click="EnableUsbTcpip_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Content="Ativar ADB TCP/IP no Android USB selecionado"/>
