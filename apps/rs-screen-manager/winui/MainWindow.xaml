                                <Button Content="Abrir gravações e imagens" Click="OpenRecordings_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PerformanceCard}">
