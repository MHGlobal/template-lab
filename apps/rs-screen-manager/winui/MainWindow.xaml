<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RSScreenManagerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RS Screen Manager · connect+">
    <Grid x:Name="RootGrid" Background="#090B10" RequestedTheme="Dark" Loaded="Root_Loaded" SizeChanged="Root_SizeChanged" RowDefinitions="Auto,Auto,*,Auto" FontFamily="Segoe UI">
        <Grid.Resources>
            <AcrylicBrush x:Key="GlassBrush" TintColor="#182337" TintOpacity="0.68" TintLuminosityOpacity="0.50" FallbackColor="#141D29"/>
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource GlassBrush}"/>
                <Setter Property="BorderBrush" Value="#34495F"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="24"/>
            </Style>
            <Style x:Key="BlueButton" TargetType="Button">
                <Setter Property="Background" Value="#007BFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="18,12"/>
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="#1D2A3B"/>
                <Setter Property="Foreground" Value="#F5F8FD"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="15,11"/>
            </Style>
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#AAB9CC"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="NavActiveButton" TargetType="Button">
                <Setter Property="Background" Value="#1B3452"/>
                <Setter Property="Foreground" Value="#F7FBFF"/>
                <Setter Property="BorderBrush" Value="#3A76C1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="MinHeight" Value="44"/>
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#DAE6F4"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <!-- Brand mark: abstract linked-screens glyph, consistent at small sizes. -->
        <Grid Padding="30,19,30,17" ColumnDefinitions="Auto,*,Auto" MinHeight="90">
            <Border Width="48" Height="48" Background="#007BFF" CornerRadius="12" VerticalAlignment="Center" BorderBrush="#5DB4FF" BorderThickness="1">
                <Viewbox Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="40" Height="40">
                        <Path Data="M 8,9 L 26,9 Q 31,9 31,14 L 31,26" Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M 32,31 L 14,31 Q 9,31 9,26 L 9,15" Stroke="#FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M 15,23 L 25,17" Stroke="#C7EDFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Ellipse Width="6" Height="6" Canvas.Left="8" Canvas.Top="7" Fill="#FFFFFF"/>
                        <Ellipse Width="6" Height="6" Canvas.Left="26" Canvas.Top="27" Fill="#FFFFFF"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0" Spacing="2">
                <TextBlock Text="RS Screen Manager" FontSize="19" FontWeight="SemiBold" Foreground="#F7F9FD"/>
                <TextBlock Text="connect+  ·  WINDOWS CONTROL" FontSize="10" CharacterSpacing="75" Foreground="#87B8F5"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Border Background="#13291F" BorderBrush="#2D6548" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#83D9A4"/>
                        <TextBlock x:Name="OnlineBadge" Text="A verificar dispositivos" Foreground="#C6E9D2" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Click="Refresh_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="Atualizar dispositivos" ToolTipService.ToolTip="Atualizar dispositivos">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="15"/>
                        <TextBlock Text="Atualizar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Six grouped navigation targets; all eleven functional pages remain available. -->
        <Grid Grid.Row="1" Padding="30,2,30,14" ColumnDefinitions="*,Auto" MinHeight="64">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button x:Name="NavHome" Click="Home_Click" Style="{StaticResource NavActiveButton}" AutomationProperties.Name="Início">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Início"/></StackPanel>
                    </Button>
                    <Button x:Name="NavDevices" Click="Devices_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Dispositivos">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE772;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Dispositivos"/></StackPanel>
                    </Button>
                    <Button x:Name="NavSessions" Style="{StaticResource NavButton}" AutomationProperties.Name="Sessões">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Sessões"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Espelhamento" Click="MirrorPage_Click"/>
                            <MenuFlyoutItem Text="Ecrãs virtuais" Click="VirtualPage_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="NavGaming" Style="{StaticResource NavButton}" AutomationProperties.Name="Gaming">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Gaming"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Centro Gaming" Click="Gaming_Click"/>
                            <MenuFlyoutItem Text="Editor de controlos" Click="Mapper_Click"/>
                            <MenuFlyoutItem Text="Perfis de desempenho" Click="Profiles_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                    <Button x:Name="NavLibrary" Click="History_Click" Style="{StaticResource NavButton}" AutomationProperties.Name="Biblioteca">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Biblioteca"/></StackPanel>
                    </Button>
                    <Button x:Name="NavTools" Style="{StaticResource NavButton}" AutomationProperties.Name="Ferramentas e definições">
                        <Button.Content><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16"/><TextBlock Text="Ferramentas"/><FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10"/></StackPanel></Button.Content>
                        <Button.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="Diagnóstico" Click="Diagnostics_Click"/>
                            <MenuFlyoutItem Text="Definições" Click="Settings_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Ajuda e primeiros passos" Click="Help_Click"/>
                        </MenuFlyout></Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="CurrentLocationText" Grid.Column="1" Text="Visão geral" Foreground="#8D9DB2" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer x:Name="HomePanel">
                <StackPanel MaxWidth="1210" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="O teu espaço de controlo" Foreground="#F5F8FF" FontSize="32" FontWeight="SemiBold"/>
                        <TextBlock Text="Liga dispositivos, inicia sessões e gere ecrãs num único lugar." Foreground="#A9B7CA" FontSize="14"/>
                    </StackPanel>
                    <Border Style="{StaticResource GlassCard}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="14">
                                <TextBlock Text="COMEÇAR AGORA" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Cria um ecrã virtual independente" Foreground="White" FontWeight="SemiBold" FontSize="23" TextWrapping="Wrap"/>
                                <TextBlock Text="Trabalha no Android enquanto manténs o ecrã principal disponível. Escolhe a resolução e o dispositivo na página de ecrãs virtuais." Foreground="#B1BFD1" FontSize="13" TextWrapping="Wrap" MaxWidth="650"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="＋ Criar ecrã virtual" Click="VirtualPage_Click" Style="{StaticResource BlueButton}"/>
                                    <Button Content="Espelhar telemóvel" Click="Mirror_Click" Style="{StaticResource QuietButton}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="140" Height="150" Background="#182B49" BorderBrush="#405681" BorderThickness="1" CornerRadius="11" VerticalAlignment="Center">
                                <Grid Margin="18">
                                    <Border Background="#23385B" Width="78" Height="120" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="#6D84B8" BorderThickness="2"/>
                                    <Border Background="#007BFF" Width="74" Height="109" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#A2D4FF" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <TextBlock Text="▣" FontSize="32" HorizontalAlignment="Center" Foreground="White"/>
                                            <Border Background="#A9D6FF" Height="5" Width="40" CornerRadius="2"/>
                                            <Border Background="#6BB4FF" Height="5" Width="28" CornerRadius="2"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="DISPOSITIVOS" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceCountText" Text="A procurar dispositivos..." Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceSummaryText" Text="Liga por USB ou configura depuração sem fios." Foreground="#AAB8CC" TextWrapping="Wrap" FontSize="13"/>
                                <Button Content="Gerir dispositivos →" Click="Devices_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="SESSÕES" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SessionCountText" Text="0 sessões nesta execução" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="Espelhamento e ecrãs virtuais em janelas independentes." Foreground="#AAB8CC" TextWrapping="Wrap" FontSize="13"/>
                                <Button Content="Gerir espelhamento →" Click="MirrorPage_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="◎" FontSize="23" Foreground="#79B6FF"/>
                                <TextBlock Text="Gaming" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Perfis de controlo e estado do mapeamento." TextWrapping="Wrap" Foreground="#AAB8CC" FontSize="12"/>
                                <Button Content="Abrir Gaming →" Click="Gaming_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="◷" FontSize="23" Foreground="#79B6FF"/>
                                <TextBlock Text="Perfis" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Configurações rápidas para vídeo e desempenho." TextWrapping="Wrap" Foreground="#AAB8CC" FontSize="12"/>
                                <Button Content="Ver perfis →" Click="Profiles_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource GlassCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="⊙" FontSize="23" Foreground="#79B6FF"/>
                                <TextBlock Text="Diagnóstico" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="Estado ADB, permissões e ajuda de ligação." TextWrapping="Wrap" Foreground="#AAB8CC" FontSize="12"/>
                                <Button Content="Ver estado →" Click="Diagnostics_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DevicesPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Os teus dispositivos" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Deteção USB e Wi-Fi. Apenas dispositivos autorizados podem iniciar sessões." Foreground="#A9B7CA" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="DISPOSITIVOS DETETADOS" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ComboBox x:Name="DevicesCombo" PlaceholderText="Sem dispositivo selecionado" HorizontalAlignment="Stretch" SelectionChanged="DeviceSelection_Changed"/>
                            <GridView x:Name="DeviceGrid" MaxHeight="240" SelectionMode="Single" SelectionChanged="GridSelection_Changed" HorizontalAlignment="Stretch">
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="230" Height="122" Background="#243045" CornerRadius="9" BorderThickness="1" BorderBrush="#50617E" Padding="16" Margin="3">
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="▣  ANDROID" Foreground="#78B5FF" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding}" Foreground="White" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                                <TextBlock Text="Selecionar dispositivo" Foreground="#A9B9D0" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            <Button Content="↻ Procurar dispositivos" Click="Refresh_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ASSISTENTE DE LIGAÇÃO SEM FIOS" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="1. No Android, abre Opções de programador → Depuração sem fios → Emparelhar com código." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBlock Text="2. Introduz o endereço IP:porta do emparelhamento e o PIN de seis dígitos." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBlock Text="3. Depois do emparelhamento, usa o endereço IP:porta de ligação, que pode ser diferente." Foreground="#D8E1EE" TextWrapping="Wrap"/>
                            <TextBox x:Name="EndpointBox" Header="Endereço IP:porta" PlaceholderText="192.168.1.10:37123"/>
                            <TextBox x:Name="PairCodeBox" Header="Código de emparelhamento" PlaceholderText="6 dígitos"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Emparelhar" Click="Pair_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="Conectar" Click="Connect_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="Desconectar" Click="Disconnect_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MirrorPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Espelhamento" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Abre o ecrã físico do Android numa janela scrcpy independente, com controlo do rato e teclado." Foreground="#A9B7CA" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="SESSÃO DE ESPELHAMENTO" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Usa o dispositivo selecionado na página Dispositivos. Ajusta a qualidade na página Definições." Foreground="#BECBE0" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="RecordMirrorToggle" Header="Gravar esta sessão em MP4" IsOn="False"/>
                            <TextBlock Text="A gravação será guardada localmente. Para finalizar o MP4 sem corromper, termina a sessão pelo gestor." Foreground="#9DAFC6" FontSize="12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="▶ Iniciar espelhamento" Click="Mirror_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="■ Terminar última sessão" Click="Stop_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="◫ Screenshot" Click="Screenshot_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="11">
                            <TextBlock Text="SESSÕES ATIVAS · CONTROLO INDIVIDUAL" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ListView x:Name="MirrorSessionsList" MaxHeight="215" SelectionMode="Single" HorizontalAlignment="Stretch"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Terminar sessão selecionada" Click="StopMirrorSelected_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="Abrir gravações e imagens" Click="OpenRecordings_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="JANELAS E VISUALIZAÇÃO" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="A versão atual abre o vídeo numa janela scrcpy independente. A visualização integrada na aplicação e a grelha de vídeos em tempo real requerem um renderizador próprio e ainda não estão disponíveis." Foreground="#B9C7D8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="VirtualPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Ecrãs virtuais" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Cria um ecrã Android independente sem substituir o ecrã físico. A compatibilidade depende do dispositivo." Foreground="#A9B7CA" TextWrapping="Wrap"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="NOVA SESSÃO VIRTUAL" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Seleciona primeiro um dispositivo autorizado na página Dispositivos." Foreground="#BECBE0"/>
                            <TextBlock Text="Resolução / densidade" Foreground="#D8E3EF"/>
                            <ComboBox x:Name="ResolutionCombo" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <x:String>1080x1920/320</x:String>
                                <x:String>1920x1080/320</x:String>
                                <x:String>720x1280/320</x:String>
                            </ComboBox>
                            <TextBox x:Name="LauncherBox" Header="Pacote launcher virtual" Text="org.fossify.home" PlaceholderText="org.fossify.home"/>
                            <ToggleSwitch x:Name="RecordVirtualToggle" Header="Gravar este ecrã virtual em MP4" IsOn="False"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="＋ Criar ecrã virtual" Click="Virtual_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="■ Terminar última sessão" Click="Stop_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                            <TextBlock Text="Nota: ecrã virtual não é o Segundo Espaço do HyperOS." Foreground="#B4C2D7" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="11">
                            <TextBlock Text="SESSÕES VIRTUAIS E FÍSICAS ATIVAS" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ListView x:Name="VirtualSessionsList" MaxHeight="215" SelectionMode="Single" HorizontalAlignment="Stretch"/>
                            <Button Content="Terminar sessão selecionada" Click="StopVirtualSelected_Click" Style="{StaticResource BlueButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GamingPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <Border Background="#33271B" BorderBrush="#87FF6B35" BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="GAMING · RS SCREEN MANAGER" Foreground="#FF6B35" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Um espaço próprio para jogar" Foreground="White" FontSize="29" FontWeight="SemiBold"/>
                            <TextBlock Text="Identidade RS com destaque laranja. Aqui o desempenho do vídeo tem prioridade sobre os efeitos de transparência." Foreground="#D9CABF" TextWrapping="Wrap"/>
                            <Button Content="Abrir editor de controlos →" Click="Mapper_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="ESTADO DA FUNCIONALIDADE" Foreground="#FF6B35" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="O motor C++ de estados WASD/mira/disparo já dispõe de testes. A injeção multitoque real no Android, os perfis por jogo e o editor drag-and-drop ainda exigem integração com o protocolo de controlo do scrcpy. Não estão operacionais nesta versão." TextWrapping="Wrap" Foreground="#D0DBEA"/>
                            <Button Content="Abrir gestor nativo avançado" Click="Advanced_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MapperPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Editor de controlos" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="IMPLEMENTAÇÃO PENDENTE" Foreground="#FF6B35" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="O editor visual de mapeamento ainda não está ligado ao fluxo de vídeo e ao motor de injeção de toques. Apresentar aqui um editor interativo antes dessa integração daria a impressão errada de que os comandos funcionam." Foreground="#CDD9E8" TextWrapping="Wrap"/>
                            <TextBlock Text="Requisitos aprovados: WASD→joystick, mira com rato, disparo, multitoque, gamepads, macros, perfis por jogo, drag-and-drop, sobreposições, desfazer/refazer e importação/exportação de perfis." Foreground="#AABAD0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ProfilesPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Perfis de desempenho" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="13">
                            <TextBlock Text="QUALIDADE DE SESSÃO" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Escolhe um perfil para configurar FPS e bitrate. As preferências são guardadas localmente." Foreground="#BECBE0" TextWrapping="Wrap"/>
                            <ComboBox x:Name="ProfileCombo" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <x:String>Eco</x:String><x:String>Equilibrado</x:String><x:String>Qualidade</x:String><x:String>Gaming</x:String>
                            </ComboBox>
                            <Button Content="Aplicar perfil" Click="ApplyProfile_Click" Style="{StaticResource BlueButton}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ProfileSummaryText" Text="Equilibrado: 60 FPS e 16 Mbps." Foreground="#AABAD0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Diagnóstico" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ESTADO DO SISTEMA" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DiagnosticsText" Text="A aguardar diagnóstico..." Foreground="#DAE5F3" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <Button Content="↻ Atualizar diagnóstico" Click="Refresh_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PERMISSÕES E PROTEÇÃO" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="ADB requer autorização no Android. O Companion é opcional e não é instalado automaticamente. Sem root, sem contornar permissões e sem transmissão para serviços externos por esta interface." Foreground="#B9C8DD" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Definições" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="13">
                            <TextBlock Text="VÍDEO E ÁUDIO" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="FPS pretendidos" Foreground="#DDE7F4"/>
                            <ComboBox x:Name="FpsCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <x:String>60</x:String><x:String>30</x:String><x:String>90</x:String><x:String>120</x:String>
                            </ComboBox>
                            <TextBlock Text="Bitrate (Mbps)" Foreground="#DDE7F4"/>
                            <ComboBox x:Name="BitrateCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <x:String>16</x:String><x:String>8</x:String><x:String>24</x:String>
                            </ComboBox>
                            <ToggleSwitch x:Name="DuplicateAudio" Header="Duplicar áudio para Android e Windows"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ARRANQUE E RECUPERAÇÃO" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ToggleSwitch x:Name="AutoRestoreSwitch" IsOn="True" Header="Reconectar e recuperar automaticamente a última sessão autorizada"/>
                            <TextBlock Text="O restauro depende de o Android estar ligado e com autorização ADB. Nunca força acesso não autorizado." Foreground="#B5C4D8" TextWrapping="Wrap" FontSize="12"/>
                            <Button Content="Guardar definições" Click="SaveSettings_Click" Style="{StaticResource BlueButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="APARÊNCIA" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Tema escuro · #090B10 | Azul principal · #007BFF | Gaming · #FF6B35" Foreground="#CFD9E9" TextWrapping="Wrap"/>
                            <TextBlock Text="O dashboard usa Glass destacado; as áreas de vídeo e Gaming reduzem efeitos para preservar o FPS." Foreground="#AABAD0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Histórico e gravações" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SESSÕES NESTA EXECUÇÃO" Foreground="#80BAFF" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HistoryText" Text="Ainda não há sessões registadas." Foreground="#D0DBEB" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="Gravações MP4 e screenshots ficam em %LOCALAPPDATA%\\RS Screen Manager\\Recordings. A catalogação e pesquisa avançada ainda não estão disponíveis." Foreground="#9BAEC7" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="FICHEIROS GUARDADOS" Foreground="#80BAFF" FontWeight="SemiBold" FontSize="12"/>
                            <ListView x:Name="RecordingsList" MaxHeight="260" SelectionMode="Single" HorizontalAlignment="Stretch"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="▶ Abrir selecionado" Click="OpenSelectedRecording_Click" Style="{StaticResource BlueButton}"/>
                                <Button Content="↻ Atualizar" Click="RefreshRecordings_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="Abrir pasta" Click="OpenRecordings_Click" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HelpPanel" Visibility="Collapsed">
                <StackPanel MaxWidth="1050" HorizontalAlignment="Stretch" Padding="32,24,32,56" Spacing="18">
                    <TextBlock Text="Primeiros passos" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel Spacing="13">
                            <TextBlock Text="1  Ativa as Opções de programador e Depuração USB no Android." Foreground="#D5E0EF" TextWrapping="Wrap"/>
                            <TextBlock Text="2  Liga o telemóvel por USB e autoriza a chave RSA no dispositivo." Foreground="#D5E0EF" TextWrapping="Wrap"/>
                            <TextBlock Text="3  Abre Dispositivos e verifica se o estado é device (autorizado)." Foreground="#D5E0EF" TextWrapping="Wrap"/>
                            <TextBlock Text="4  Escolhe Espelhamento ou Ecrãs virtuais para iniciar." Foreground="#D5E0EF" TextWrapping="Wrap"/>
                            <TextBlock Text="Para Wi-Fi, o endereço de emparelhamento pode ser diferente do de conexão. O assistente está na página Dispositivos." Foreground="#A9BBD3" TextWrapping="Wrap"/>
                            <Button Content="Ir para Dispositivos →" Click="Devices_Click" Style="{StaticResource BlueButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Feedback never floats over forms or session controls. -->
        <Border Grid.Row="3" Background="#101720" BorderBrush="#293447" BorderThickness="0,1,0,0" MinHeight="42" Padding="30,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="#62B1FF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="A iniciar RS Screen Manager..." Foreground="#BECDDF" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="2" Text="connect+ · v0.2.2 preview" Foreground="#647C96" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>