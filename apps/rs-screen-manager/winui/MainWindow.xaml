                                <Button Click="Stop_Click" Style="{StaticResource QuietButton}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="14"/><TextBlock Text="Terminar última sessão"/></StackPanel></Button>
